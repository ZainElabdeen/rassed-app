<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window behind the first Compose frame. Its background follows the app's
        own; the approved design writes window_colors.xml with its background colours.
        The app is light in every system setting unless the person asks for dark, so
        values-night holds the same light theme: an app that follows the system puts
        android:Theme.Material.NoActionBar and its dark background there.
    -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
